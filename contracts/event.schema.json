{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic security event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "device",
    "incident",
    "detections",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "device": {
      "type": "object",
      "required": [
        "device_id",
        "platform",
        "network"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "windows",
            "android",
            "ios"
          ]
        },
        "network": {
          "type": "object",
          "required": [
            "country",
            "state",
            "city",
            "asn"
          ],
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "state": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "asn": {
              "type": "integer",
              "minimum": 64512,
              "maximum": 65534
            }
          }
        }
      }
    },
    "incident": {
      "type": "object",
      "required": [
        "status",
        "risk_score"
      ],
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "pending",
            "dismissed"
          ]
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "detections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "signature",
          "category",
          "occurrences",
          "impact_score",
          "confidence"
        ],
        "properties": {
          "signature": {
            "type": "string"
          },
          "category": {
            "enum": [
              "credential_attack",
              "network_scan",
              "malware_indicator",
              "policy_violation",
              "data_exfiltration"
            ]
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "impact_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "channel",
        "sensor_version",
        "flags"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "sensor_version": {
          "type": "string"
        },
        "flags": {
          "type": "object",
          "required": [
            "synthetic"
          ],
          "properties": {
            "synthetic": {
              "const": true
            }
          }
        }
      }
    }
  }
}
